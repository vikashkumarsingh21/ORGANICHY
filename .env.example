# ==============================================================================
# ORGANICHY E-COMMERCE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or configure in Render Dashboard under Environment Variables)
# DO NOT commit real secrets, private keys, or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Node Environment ('production' for live deployments, 'development' locally)
NODE_ENV=production

# Base URL of the deployed application (used for SEO canonical URLs, sitemaps, emails)
# Set this to your live custom domain or Render URL (e.g. https://organichy.onrender.com)
NEXT_PUBLIC_SITE_URL=https://organichy.com
NEXT_PUBLIC_APP_URL=https://organichy.com

# Brand Display Info
NEXT_PUBLIC_STORE_NAME="ORGANICHY Pure Nutrition"
NEXT_PUBLIC_SUPPORT_EMAIL=support@organichy.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Security Flag: Set to "false" in production to disable pre-filled demo login buttons
NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon PostgreSQL / Hosted PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string with pooled or direct connection to PostgreSQL with SSL required:
# Example: postgresql://<user>:<password>@<neon-hostname>/organichy_db?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/organichy_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate high-entropy 64-character random hex strings:
# openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_key
NEXTAUTH_SECRET=replace_with_a_secure_random_64_char_hex_secret_key

# Default Administrator Account (used for initial seeding / emergency auth)
ADMIN_NAME="Sourav - ORGANICHY Admin"
ADMIN_EMAIL=admin@organichy.com
ADMIN_PASSWORD=replace_with_a_strong_unique_admin_production_password

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard -> Account Details:
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks:
# Use 'rzp_test_...' for staging/testing and 'rzp_live_...' for production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_public_key_here
RAZORPAY_KEY_ID=rzp_live_your_public_key_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Secret configured in Razorpay Webhook settings for signature verification:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. SHIPPING & LOGISTICS (Shiprocket / Delhivery / Manual)
# ------------------------------------------------------------------------------
# Select shipping provider: 'MANUAL', 'SHIPROCKET', or 'DELHIVERY'
SHIPPING_PROVIDER=MANUAL

# Shiprocket API Credentials (leave empty if using MANUAL mode):
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Delhivery API Credentials (leave empty if using MANUAL mode):
DELHIVERY_API_KEY=

# ------------------------------------------------------------------------------
# 7. NOTIFICATIONS & INTEGRATIONS (Optional / Extensible)
# ------------------------------------------------------------------------------
# Transactional Email (Resend or SendGrid)
RESEND_API_KEY=
SENDGRID_API_KEY=

# WhatsApp Business API / Twilio
WHATSAPP_API_KEY=
TWILIO_AUTH_TOKEN=
